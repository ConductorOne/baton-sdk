{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.conductorone.com/multipass/secret-contracts/v1/api_key_v2.schema.json",
  "title": "api_key_v2",
  "x-secret-content-type": "api_key_v2",
  "description": "An API key with the provider details a client needs to present it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key_value"
  ],
  "properties": {
    "key_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072,
      "x-non-blank": true
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    },
    "base_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072,
      "x-semantic": [
        "http_url"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string",
        "x-max-utf8-bytes": 4096
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    },
    "header_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "minLength": 1,
      "maxLength": 10,
      "x-max-utf8-bytes": 10,
      "x-semantic": [
        "rfc3339_full_date"
      ]
    }
  },
  "x-max-document-bytes": 524288
}
