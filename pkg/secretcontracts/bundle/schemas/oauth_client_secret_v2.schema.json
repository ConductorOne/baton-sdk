{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.conductorone.com/multipass/secret-contracts/v1/oauth_client_secret_v2.schema.json",
  "title": "oauth_client_secret_v2",
  "x-secret-content-type": "oauth_client_secret_v2",
  "description": "An OAuth client credential with optional endpoints, grant type, audience, scopes and redirect URIs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "client_secret"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    },
    "client_secret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    },
    "token_endpoint_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072,
      "x-semantic": [
        "http_url"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string",
        "x-max-utf8-bytes": 4096
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "issuer_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072,
      "x-semantic": [
        "http_url"
      ]
    },
    "redirect_uri": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string",
        "x-max-utf8-bytes": 4096
      },
      "maxItems": 64,
      "uniqueItems": true,
      "x-semantic": [
        "absolute_uri_items"
      ]
    },
    "auth_endpoint_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072,
      "x-semantic": [
        "http_url"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    },
    "grant_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-max-utf8-bytes": 131072
    }
  },
  "x-max-document-bytes": 524288
}
